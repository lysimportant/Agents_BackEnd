# C 端门户环境变量示例。复制为 .env.local 并按环境修改取值。
# 后端 API 地址，开发环境默认指向本机后端服务。
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
# C 端门户站点地址，生产环境必须为 HTTPS 域名，用于 canonical/sitemap/RSS/分享链接。
NEXT_PUBLIC_SITE_URL=http://localhost:3001
# 是否启用客服聊天入口。
NEXT_PUBLIC_ENABLE_CUSTOMER_CHAT=false
# 客服聊天入口地址，启用时必填。
NEXT_PUBLIC_CUSTOMER_CHAT_URL=
# 门户数据缓存秒数，默认 60 秒。
PORTAL_REVALIDATE_SECONDS=60
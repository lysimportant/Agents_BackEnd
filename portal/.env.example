# 浏览器可访问的后端地址，开发默认 http://localhost:8080
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# C 端绝对站点地址，开发默认 http://localhost:3001；生产必须是最终 HTTPS 域名
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# 是否启用客服入口，默认 false
NEXT_PUBLIC_ENABLE_CUSTOMER_CHAT=false

# 服务端内容缓存秒数，默认 60，必须为合理正整数
PORTAL_REVALIDATE_SECONDS=60

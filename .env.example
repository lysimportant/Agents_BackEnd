# 前端与后端对外映射端口，可按需修改为未占用的宿主机端口。
BACKEND_PORT=8080
FRONTEND_PORT=3000

# 容器内部端口（通常不需要修改，除非有特殊需求）
BACKEND_INTERNAL_PORT=8080

# 浏览器访问前端时使用的后端地址；端口修改后同步修改。
FRONTEND_API_BASE_URL=http://localhost:8080
FRONTEND_SITE_URL=http://localhost:3000

# 允许携带 Cookie 的前端来源，多个来源用逗号分隔。
CORS_ALLOWED_ORIGINS=http://localhost:3000

# 宿主机持久化目录；默认使用 backend/data 与 backend/uploads。
DATA_DIR=./backend/data
UPLOAD_DIR=./backend/uploads

# SMTP 配置文件，默认读取仓库根目录的 email.txt。
EMAIL_CONFIG_FILE=./email.txt

# 可选：也可直接通过环境变量配置 SMTP；非空值优先于 email.txt。
EMAIL_HOST=
EMAIL_PORT=
EMAIL_SECURE=
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# 可选：Redis 与会话设置。
REDIS_PASSWORD=
REDIS_DB=0
SESSION_TTL_HOURS=8
PASSWORD_CODE_TTL_SECONDS=180
VISITOR_LOG_RETENTION_DAYS=90
COOKIE_SAMESITE=Lax
COOKIE_SECURE=false

# 可选：启用仅超级管理员可用的部署机直连。请生成至少 32 字节随机令牌，
# 并把相同值写入宿主机 /etc/collector-host-agent.env；留空时后端禁用代理注册。
HOST_AGENT_TOKEN=

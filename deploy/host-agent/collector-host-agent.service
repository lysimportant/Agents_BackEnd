[Unit]
Description=Collector Host Terminal Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=collector-terminal
Group=collector-terminal
EnvironmentFile=/etc/collector-host-agent.env
ExecStart=/usr/local/bin/collector-host-agent
Restart=always
RestartSec=5
TimeoutStopSec=15
KillMode=mixed
UMask=0077

[Install]
WantedBy=multi-user.target

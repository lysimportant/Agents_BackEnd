# 后端公开可访问的宿主机代理 WebSocket；HTTPS 部署使用 wss://。
HOST_AGENT_SERVER_URL=wss://api.example.com/api/server/host-agent

# 与后端 HOST_AGENT_TOKEN 完全一致的随机长令牌，不要提交真实值。
HOST_AGENT_TOKEN=replace-with-at-least-32-random-bytes

# 管理界面展示名称和本地登录 shell。
HOST_AGENT_NAME=production-server
HOST_AGENT_SHELL=/bin/bash
HOST_AGENT_RECONNECT_SECONDS=5
